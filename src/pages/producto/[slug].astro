---
import Layout from '../../layouts/Layout.astro';
import GrillaProductos from '../../components/GrillaProductos.astro';
import InyectarCatalogo from '../../components/InyectarCatalogo.astro';
import productos from '../../datos/productos.json';
import categorias from '../../datos/categorias.json';
import { pesos } from '../../scripts/formato.js';

export function getStaticPaths() {
  return productos.map((p) => ({ params: { slug: p.slug }, props: { producto: p } }));
}

const { producto: p } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const cat = categorias.find((c) => c.slug === p.categoria);
const relacionados = productos
  .filter((x) => x.categoria === p.categoria && x.slug !== p.slug && x.stock)
  .slice(0, 5);
const descuento =
  p.precio_antes && p.precio_antes > p.precio
    ? Math.round((1 - p.precio / p.precio_antes) * 100)
    : null;
---

<Layout titulo={p.titulo} descripcion={p.descripcion}>
  <div class="contenedor py-8">
    <nav class="mb-6 text-sm text-tinta-suave" aria-label="Migas de pan">
      <a href={`${B}/`} class="hover:text-verde">Inicio</a>
      <span class="mx-1.5">/</span>
      <a href={`${B}/categoria/${p.categoria}`} class="hover:text-verde">{cat?.titulo}</a>
      <span class="mx-1.5">/</span>
      <span class="font-bold text-tinta">{p.titulo}</span>
    </nav>

    <div class="grid gap-8 rounded-3xl border border-verde/10 bg-white p-5 sm:p-8 lg:grid-cols-2">
      <div class="relative">
        <img
          src={`${B}/img/productos/${p.imagenes[0]}`}
          alt={p.titulo}
          class="mx-auto aspect-square w-full max-w-md rounded-2xl object-contain"
          width="700"
          height="700"
        />
        {descuento && (
          <span class="absolute left-2 top-2 rounded-full bg-naranja px-3 py-1.5 text-sm font-black text-white">-{descuento}%</span>
        )}
      </div>

      <div class="flex flex-col">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-naranja">{p.marca}</p>
        <h1 class="mt-1 text-3xl font-black leading-tight">{p.titulo}</h1>
        <p class="mt-3 text-base leading-relaxed text-tinta-suave">{p.descripcion}</p>

        <dl class="mt-5 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-2xl bg-crema p-3">
            <dt class="text-xs font-bold text-tinta-suave">Presentación</dt>
            <dd class="font-extrabold">{p.presentacion || '—'}</dd>
          </div>
          <div class="rounded-2xl bg-crema p-3">
            <dt class="text-xs font-bold text-tinta-suave">Categoría</dt>
            <dd class="font-extrabold">{cat?.titulo}</dd>
          </div>
        </dl>

        <div class="mt-6">
          {p.precio_antes && p.precio_antes > p.precio && (
            <p class="text-lg text-tinta-suave line-through">{pesos(p.precio_antes)}</p>
          )}
          <p class="text-4xl font-black text-verde">{pesos(p.precio)}</p>
          <p class="mt-1 text-xs font-semibold text-naranja">Precio de demostración</p>
        </div>

        <button
          data-agregar={p.slug}
          class="mt-6 w-full rounded-2xl bg-verde py-4 text-sm font-black uppercase tracking-wide text-white shadow-lg shadow-verde/20 transition hover:bg-verde-oscuro sm:w-auto sm:px-10"
        >
          Agregar al pedido
        </button>
        <p class="mt-3 text-xs text-tinta-suave">Al agregar, envía el pedido completo por WhatsApp desde el carrito.</p>
      </div>
    </div>

    {relacionados.length > 0 && (
      <section class="mt-14">
        <h2 class="mb-5 text-2xl font-black">También te puede interesar</h2>
        <GrillaProductos productos={relacionados} columnas={5} />
      </section>
    )}
  </div>
  <InyectarCatalogo slot="scripts" productos={productos} />
</Layout>
