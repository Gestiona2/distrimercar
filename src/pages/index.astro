---
import Layout from '../layouts/Layout.astro';
import GrillaProductos from '../components/GrillaProductos.astro';
import GrillaMarcas from '../components/GrillaMarcas.astro';
import RailCategorias from '../components/RailCategorias.astro';
import InyectarCatalogo from '../components/InyectarCatalogo.astro';
import productos from '../datos/productos.json';
import home from '../datos/home.json';
import config from '../datos/config.json';

const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const destacados = productos.filter((p) => p.destacado && p.stock).slice(0, 10);
const ofertas = productos.filter((p) => p.precio_antes && p.precio_antes > p.precio && p.stock).slice(0, 4);
---

<Layout>
  <section class="overflow-hidden bg-gradient-to-br from-verde via-verde to-verde-oscuro text-white">
    <div class="contenedor grid items-center gap-10 py-12 lg:grid-cols-2 lg:py-16">
      <div>
        <span class="inline-block rounded-full bg-amarillo px-3 py-1 text-xs font-black uppercase tracking-wider text-tinta">
          Distribuidora · Abarrotes y aseo
        </span>
        <h1 class="mt-4 text-4xl font-black leading-tight sm:text-5xl">
          {home.bienvenida.titulo}
        </h1>
        <p class="mt-4 max-w-lg text-base text-white/85 sm:text-lg">
          {home.bienvenida.subtitulo}
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={`${B}/catalogo`} class="rounded-2xl bg-white px-6 py-3.5 text-sm font-black uppercase tracking-wide text-verde shadow-lg transition hover:bg-amarillo hover:text-tinta">
            {home.bienvenida.cta_catalogo}
          </a>
          <a href={`https://wa.me/${config.whatsapp}`} target="_blank" rel="noopener" class="rounded-2xl border-2 border-white/70 px-6 py-3.5 text-sm font-black uppercase tracking-wide text-white transition hover:bg-white/10">
            {home.bienvenida.cta_whatsapp}
          </a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-md">
        <div class="rotate-2 rounded-3xl bg-amarillo/90 p-3 shadow-2xl">
          <img src={`${B}/img/sitio/foto-local.webp`} alt={`Local de ${config.nombre}`} class="rounded-2xl" width="809" height="613" />
        </div>
        <div class="absolute -bottom-5 -left-4 rotate-[-4deg] rounded-2xl bg-white px-4 py-3 shadow-xl">
          <p class="text-xs font-black uppercase tracking-wide text-naranja">Pide hoy</p>
          <p class="text-sm font-extrabold text-verde">WhatsApp {config.telefono_visible}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-verde/10 bg-white">
    <div class="contenedor grid gap-6 py-8 sm:grid-cols-3">
      {home.franjas.map((f) => (
        <div class="flex items-start gap-3">
          <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-verde-claro text-verde">
            {f.icono === 'message' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a8 8 0 0 1-8 8H5l-2 2V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8Z"/></svg>}
            {f.icono === 'truck' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/></svg>}
            {f.icono === 'store' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 9h16v11H4z"/><path d="M4 9 6 4h12l2 5"/><path d="M9 20v-6h6v6"/></svg>}
          </span>
          <div>
            <h2 class="text-sm font-black">{f.titulo}</h2>
            <p class="mt-0.5 text-sm text-tinta-suave">{f.texto}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <RailCategorias />

  <section class="contenedor py-12">
    <div class="mb-6 flex items-end justify-between gap-4">
      <h2 class="text-2xl font-black sm:text-3xl">{home.seccion_destacados}</h2>
      <a href={`${B}/catalogo`} class="text-sm font-extrabold text-naranja hover:underline">Ver todo →</a>
    </div>
    <GrillaProductos productos={destacados} columnas={5} />
  </section>

  {ofertas.length > 0 && (
    <section class="bg-white py-12">
      <div class="contenedor">
        <div class="mb-6 flex items-end justify-between gap-4">
          <h2 class="text-2xl font-black sm:text-3xl">
            <span class="text-naranja">%</span> {home.seccion_ofertas}
          </h2>
          <a href={`${B}/ofertas`} class="text-sm font-extrabold text-naranja hover:underline">Ver ofertas →</a>
        </div>
        <GrillaProductos productos={ofertas} columnas={4} />
      </div>
    </section>
  )}

  <section id="marcas" class="contenedor py-12">
    <h2 class="mb-6 text-center text-2xl font-black sm:text-3xl">{home.seccion_marcas}</h2>
    <GrillaMarcas />
  </section>

  <section class="bg-gradient-to-r from-naranja to-naranja-oscuro py-12 text-white">
    <div class="contenedor flex flex-col items-center gap-5 text-center">
      <h2 class="text-2xl font-black sm:text-3xl">¿Listo para pedir?</h2>
      <p class="max-w-xl text-white/90">Arma tu carrito en el catálogo y envíanos el pedido completo por WhatsApp. Te confirmamos disponibilidad y domicilio.</p>
      <a href={`https://wa.me/${config.whatsapp}`} target="_blank" rel="noopener" class="rounded-2xl bg-white px-8 py-3.5 text-sm font-black uppercase tracking-wide text-naranja shadow-lg transition hover:bg-amarillo hover:text-tinta">
        Escríbenos por WhatsApp
      </a>
    </div>
  </section>

  <InyectarCatalogo slot="scripts" productos={productos} />
</Layout>
